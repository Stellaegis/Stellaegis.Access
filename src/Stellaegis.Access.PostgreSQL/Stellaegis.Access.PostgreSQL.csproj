<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Access.PostgreSQL</RootNamespace>
    <PackageId>Stellaegis.Access.PostgreSQL</PackageId>
    <Description>The PostgreSQL stores of Stellaegis.Access: the effective rights of the three domains — persons in a compartment, operators of the platform, M2M clients — in the schema authz, with the declaration of the database for its installation and its verification at startup.</Description>
    <PackageTags>stellaegis;access;authorization;postgresql;dapper</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Stellaegis.Primitives.Data" />
    <ProjectReference Include="..\Stellaegis.Access\Stellaegis.Access.csproj" />
    <InternalsVisibleTo Include="Stellaegis.Access.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sql\**\*.sql" />
  </ItemGroup>

</Project>
