<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Access.SqlServer</RootNamespace>
    <PackageId>Stellaegis.Access.SqlServer</PackageId>
    <Description>The SQL Server stores of Stellaegis.Access: the effective rights of the three domains — persons in a compartment, operators of the platform, M2M clients — in the schema authz, with the declaration of the database for its installation and its verification at startup.</Description>
    <PackageTags>stellaegis;access;authorization;sqlserver;dapper</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Pinned above the vulnerable version Microsoft.Data.SqlClient pulls in; see Directory.Packages.props -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Stellaegis.Primitives.Data" />
    <ProjectReference Include="..\Stellaegis.Access\Stellaegis.Access.csproj" />
    <InternalsVisibleTo Include="Stellaegis.Access.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sql\**\*.sql" />
  </ItemGroup>

</Project>
